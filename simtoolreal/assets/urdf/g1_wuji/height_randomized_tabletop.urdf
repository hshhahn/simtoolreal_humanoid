<?xml version="1.0"?>
<robot name="g1_height_randomized_tabletop">
  <!-- Kinematic 5 cm slab: no fixed-length legs intersect the ground at low heights. -->
  <link name="table">
    <inertial><mass value="100"/><inertia ixx="10" iyy="10" izz="10" ixy="0" ixz="0" iyz="0"/></inertial>
    <visual><geometry><box size="0.65 0.45 0.05"/></geometry><material name="wood"><color rgba="0.65 0.42 0.25 1"/></material></visual>
    <collision><geometry><box size="0.65 0.45 0.05"/></geometry></collision>
  </link>
</robot>
